[Unit]
Description=Home dashboard (Ryuk summaries)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Usually the pi user on Raspberry Pi OS. On a laptop, replace it with your account.
User=pi
Group=pi
WorkingDirectory=/opt/home-dashboard
EnvironmentFile=/opt/home-dashboard/.env
ExecStart=/opt/home-dashboard/.venv/bin/python -m app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
