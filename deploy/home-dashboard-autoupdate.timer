[Unit]
Description=Check for Home Dashboard updates every 10 minutes, on the full ten

[Timer]
# Fire every 10 minutes on full clock minutes (e.g. 20:00, 20:10, 20:20, ...)
OnCalendar=*:0/10:00
# One-second accuracy (no delay and no jitter)
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
