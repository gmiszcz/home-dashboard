# Token Ryuk uses to sign POST /api/update and POST /api/updates.
# Compared in constant time. At least 8 characters. Never commit the real value.
DASHBOARD_TOKEN=change-me-long-random-token

# Path to the SQLite file. A relative path is resolved from the repository root.
DB_PATH=data/dashboard.sqlite

# Listen address. In production use the Tailscale address (100.x.y.z) or a LAN interface.
# 0.0.0.0 exposes the service on every interface, keep it away from the public internet.
HOST=0.0.0.0
PORT=8000

# Optional read protection (GET /api/latest, GET /api/section/..., WebSocket /ws).
# Empty = reads without a token, for LAN/Tailscale only. GET /api/health stays open.
READ_TOKEN=

# Optional history retention, in days. Empty = keep everything.
# The newest row of every section is always kept.
RETENTION_DAYS=

# Maximum POST request body size, in bytes.
MAX_BODY_BYTES=262144

# Only reported by GET /api/health as stale_after_minutes. The data-age LED on
# every tile uses fixed thresholds (today / under 24 h / over 24 h) and ignores this.
STALE_AFTER_MINUTES=360

LOG_LEVEL=INFO

# --- Docker and the Pi auto-update. The Python app does not read these. ---

# Image tag Compose pulls. Leave unset for :latest. On the Pi, auto-update
# sets this to the commit SHA for that run.
# DASHBOARD_TAG=latest

# Uncomment to build the image on this machine instead of pulling GHCR.
# Leave this commented on the Pi (426 MB RAM cannot compile the frontend).
# AUTO_UPDATE_BUILD_LOCALLY=1

# Heap cap for that local build. The image itself defaults to 900, which is
# too large for the Pi, so the auto-update fallback uses 256 when this is unset.
# NODE_OPTIONS=--max-old-space-size=256
