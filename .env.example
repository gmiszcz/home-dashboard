# Token, którym Ryuk podpisuje POST /api/update i POST /api/updates.
# Porównywany w czasie stałym. Minimum 8 znaków. Nigdy nie commituj prawdziwej wartości.
DASHBOARD_TOKEN=change-me-long-random-token

# Ścieżka do pliku SQLite. Względna ścieżka jest liczona od katalogu repozytorium.
DB_PATH=data/dashboard.sqlite

# Adres nasłuchu. Na produkcji ustaw adres Tailscale (100.x.y.z) albo interfejs LAN.
# 0.0.0.0 wystawia usługę na wszystkich interfejsach — odetnij ją od publicznego Internetu.
HOST=0.0.0.0
PORT=8000

# Opcjonalna ochrona odczytu (GET /api/latest, GET /api/section/..., WebSocket /ws).
# Puste = odczyt bez tokenu, tylko dla sieci LAN/Tailscale. GET /api/health zostaje otwarty.
READ_TOKEN=

# Opcjonalna retencja historii, w dniach. Puste = trzymaj wszystko.
# Zawsze zostaje najnowszy wiersz każdej sekcji.
RETENTION_DAYS=

# Maksymalny rozmiar ciała żądania POST, w bajtach.
MAX_BODY_BYTES=262144

# Po ilu minutach kafelek na iPadzie dostaje znacznik „nieaktualne”.
STALE_AFTER_MINUTES=360

LOG_LEVEL=INFO
